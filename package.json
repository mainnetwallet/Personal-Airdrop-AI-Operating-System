{
  "name": "personal-airdrop-ai-os",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Airdrop AI Operating System (V12) - monorepo",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @airdrop-os/api dev",
    "db:generate": "pnpm --filter @airdrop-os/database db:generate",
    "db:migrate": "pnpm --filter @airdrop-os/database db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  }
}
