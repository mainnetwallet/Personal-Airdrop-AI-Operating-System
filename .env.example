# Copy to .env and fill in real values. NEVER commit the real .env file.
NODE_ENV=development

# --- Database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://airdrop_os:change-me@localhost:5432/airdrop_os

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace-with-64-char-hex-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-char-hex-secret

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Local agent / browser automation (optional) ---
# Path to a locally installed Chromium binary. Leave unset to keep
# browser automation NOT_CONFIGURED. Example (Termux): 
# /data/data/com.termux/files/usr/bin/chromium
CHROMIUM_PATH=
